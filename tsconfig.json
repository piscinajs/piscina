{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2019"],
    "declaration": true,
    "sourceMap": true,

    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "tap": ["./test/bap.ts"]
    }
  }
}
